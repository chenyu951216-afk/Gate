APP_NAME=bitget-quant-ranking-scanner
APP_ENV=production
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8080
TIMEZONE=Asia/Taipei
DATABASE_URL=
DATABASE_STARTUP_RETRIES=12
DATABASE_STARTUP_RETRY_DELAY_SECONDS=5

# Gate official REST v4: scanner, ranking, replay and historical market data.
# Gate is not the order venue in this deployment.
GATE_REST_BASE_URL=https://api.gateio.ws/api/v4
GATE_WS_URL=wss://fx-ws.gateio.ws/v4/ws/usdt
GATE_API_KEY=
GATE_API_SECRET=
GATE_SETTLE=usdt
GATE_REQUEST_TIMEOUT_SECONDS=15
GATE_MAX_CONCURRENCY=8
GATE_REQUESTS_PER_SECOND=8
GATE_RETRY_ATTEMPTS=4
GATE_CIRCUIT_FAILURE_THRESHOLD=5
GATE_CIRCUIT_RECOVERY_SECONDS=30

# Bitget v2 USDT-M Futures: create an API key with futures read/trade only;
# do not enable withdrawal permission. Passphrase is required by Bitget.
BITGET_REST_BASE_URL=https://api.bitget.com
BITGET_WS_URL=wss://ws.bitget.com/v2/ws/public
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=
BITGET_PRODUCT_TYPE=USDT-FUTURES
BITGET_MARGIN_COIN=USDT
BITGET_MARGIN_MODE=crossed
BITGET_POSITION_MODE=one_way_mode
BITGET_REQUEST_TIMEOUT_SECONDS=15
BITGET_MAX_CONCURRENCY=8
BITGET_REQUESTS_PER_SECOND=8
BITGET_RETRY_ATTEMPTS=4
BITGET_CIRCUIT_FAILURE_THRESHOLD=5
BITGET_CIRCUIT_RECOVERY_SECONDS=30

# CoinGlass remains an analysis input only.
COINGLASS_ENABLED=false
COINGLASS_API_KEY=
COINGLASS_BASE_URL=https://open-api-v4.coinglass.com
COINGLASS_REQUEST_TIMEOUT_SECONDS=10
COINGLASS_MAX_CONCURRENCY=4
COINGLASS_REQUESTS_PER_SECOND=4
COINGLASS_RETRY_ATTEMPTS=2
COINGLASS_EXCHANGE_LIST=Binance,OKX,Bybit
# Use 4h for CoinGlass Hobbyist; 30m requires a plan that supports it.
COINGLASS_INTERVAL=4h
COINGLASS_HISTORY_LIMIT=48
COINGLASS_CACHE_TTL_SECONDS=1800
COINGLASS_USE_HEATMAP=true
COINGLASS_HEATMAP_RANGE=1d
COINGLASS_REQUIRE_HEATMAP=false
COINGLASS_MAX_SYMBOLS_PER_SCAN=100

# Original scanner/ranking rules; keep these unchanged when migrating venue.
MIN_24H_TURNOVER_USDT=5000000
MAX_SPREAD_PCT=0.10
MIN_30M_CANDLES=240
MIN_4H_CANDLES=150
MIN_DATA_COMPLETENESS_PCT=70
RANKING_MIN_SCORE=55
TACTICAL_SIGNALS_ENABLED=true
TACTICAL_MIN_SCORE=72
TACTICAL_MIN_TURNOVER_RATIO=1.35
TACTICAL_MIN_ADX=22
TACTICAL_TIME_STOP_HOURS=6
TACTICAL_RISK_MULTIPLIER=0.85
ADAPTIVE_TREND_SCORE_RELIEF=3
STOCK_DEFAULT_CALENDAR=XNYS
# Non-US underlying examples: ANTA_USDT:XHKG,7203_USDT:XTKS
STOCK_CALENDAR_OVERRIDES=
BLACKLIST_CONTRACTS=
SCAN_DELAY_SECONDS=20
SCAN_ON_STARTUP=true
SCHEDULER_ENABLED=true

# Trading and continuous position management.
AUTO_ORDER_ENABLED=true
POSITION_MANAGEMENT_ENABLED=true
POSITION_MANAGER_INTERVAL_SECONDS=5
POSITION_MARKET_REFRESH_SECONDS=15
ENTRY_ORDER_MODE=limit
LIMIT_ENTRY_OFFSET_PCT=0.0005
FIVE_MINUTE_ENTRY_MAX_ATR=0.65
FIVE_MINUTE_ENTRY_MAX_DISTANCE_PCT=0.012
FIVE_MINUTE_ENTRY_FALLBACK_ATR=0.15
LIMIT_ENTRY_CANCEL_MOVE_PCT=0.015
LIMIT_ENTRY_MIN_CANCEL_MOVE_PCT=0.015
# Do not cancel on ordinary crypto noise immediately after submission.
LIMIT_ENTRY_MIN_OBSERVATION_SECONDS=30
LIMIT_ENTRY_MOMENTUM_CONFIRMATIONS=2
# A very large one-way move may cancel after a shorter, but still non-zero,
# safety window instead of chasing a runaway market.
LIMIT_ENTRY_HARD_MOVE_PCT=0.03
LIMIT_ENTRY_HARD_MOVE_MIN_OBSERVATION_SECONDS=10
LIMIT_ENTRY_TIMEOUT_SECONDS=10800
MAX_MARKET_DRIVER_POSITIONS=2
MAX_TOTAL_POSITIONS=20
MARKET_DRIVER_CONTRACTS=BTC_USDT,ETH_USDT,SOL_USDT,BNB_USDT,HYPE_USDT
# Dynamic risk sizing: stop distance, equity, available margin, signal quality
# and volatility determine every order. There are no fixed coin notionals.
RISK_PER_TRADE_PCT=0.01
MIN_RISK_PER_TRADE_PCT=0.006
MAX_RISK_PER_TRADE_PCT=0.013
MAX_POSITION_NOTIONAL_EQUITY_MULTIPLE=2.5
MAX_PORTFOLIO_NOTIONAL_EQUITY_MULTIPLE=6.0
AVAILABLE_MARGIN_UTILIZATION_PCT=0.70
MINIMUM_VIABLE_POSITION_EQUITY_MULTIPLE=0.25
MAX_PROMOTED_RISK_PER_TRADE_PCT=0.025
ORDER_BOOK_DEPTH_RANGE_PCT=0.005
TIME_STOP_BASE_HOURS=12
TIME_STOP_TREND_HOURS=18
TIME_STOP_RANGE_HOURS=6
TIME_STOP_EXTREME_HOURS=4
TIME_STOP_CONFIRMATION_EXTENSION_HOURS=6
TIME_STOP_MAX_HOLDING_HOURS=72
TIME_STOP_MIN_PROGRESS_R=0.5
REENTRY_COOLDOWN_MINUTES=90
ESTIMATED_ROUND_TRIP_FEE_PCT=0.0012
MINIMUM_NET_RR=1.0
MAX_OPERATIONAL_LEVERAGE=20
LIQUIDATION_DISTANCE_STOP_MULTIPLE=2.0
MINIMUM_ORDER_RR=1.20
REQUIRE_MAX_LEVERAGE=true
MAX_INITIAL_STOP_LOSS_USDT=0
STOP_LOSS_BUFFER_ATR=0.9
FALLBACK_STOP_ATR=2.2
MINIMUM_STOP_ATR=1.6
MINIMUM_STOP_PCT=0.01
MAXIMUM_STOP_ATR=4.5
THESIS_STOP_BUFFER_ATR=0.55
LIQUIDITY_STOP_BUFFER_ATR=0.35
COINGLASS_STOP_CONFLUENCE_ATR=0.75
BREAK_EVEN_ACTIVATION_R=1.20
STRUCTURE_TRAIL_ACTIVATION_R=2.0
RUNNER_TRAIL_ACTIVATION_R=2.5
BREAK_EVEN_FEE_BUFFER_MULTIPLE=1.25
TREND_TRAILING_ATR=3.0
RANGE_TRAILING_ATR=2.2
HIGH_VOLATILITY_TRAILING_ATR=3.5
# Robust 30m volatility model: 72h reference, 6h local state and 2h shock window.
VOLATILITY_BASELINE_BARS_30M=144
VOLATILITY_RECENT_BARS_30M=12
VOLATILITY_SHOCK_BARS_30M=4
VOLATILITY_EXPANSION_RATIO=1.50
VOLATILITY_EXPANSION_MIN_BARS=3
EXPANSION_BREAK_EVEN_ACTIVATION_R=1.50
ISOLATED_SPIKE_BREAK_EVEN_ACTIVATION_R=1.60
THESIS_SOFT_FAILURE_CONFIRMATIONS=2
REVERSAL_SIGNAL_CONFIRMATIONS=2
POSITION_TREND_15M_CANDLES=288
POSITION_EXIT_5M_CANDLES=96
POSITION_THESIS_CONFIRMATIONS=2
POSITION_THESIS_STRUCTURE_BUFFER_ATR=0.25
POSITION_THESIS_VWAP_BUFFER_ATR=0.15
POSITION_THESIS_MIN_ADX=20
POSITION_THESIS_DMI_DELTA=5
POSITION_THESIS_EMA_SLOPE_ATR=0.08
POSITION_THESIS_CANDIDATE_SCORE=6
POSITION_THESIS_DECISIVE_SCORE=8
POSITION_EXIT_5M_CONFIRMATIONS=2
POSITION_EXIT_5M_BUFFER_ATR=0.15
POSITION_EXIT_5M_MIN_ADX=18
POSITION_EXIT_5M_CANDIDATE_SCORE=4
POSITION_EXIT_EMERGENCY_R=-0.75
POSITION_EXIT_RECOVERY_MAX_LOSS_R=-0.20
STOP_UPDATE_MIN_ATR=0.20
STOP_UPDATE_COOLDOWN_SECONDS=60
TAKE_PROFIT_1_PCT=0.30
TAKE_PROFIT_2_PCT=0.30
TAKE_PROFIT_3_PCT=0.25
RUNNER_PCT=0.15
ORDER_TRIGGER_EXPIRATION_SECONDS=0

# live = formal mode; test = all new-entry notionals are multiplied by 0.1.
# The dashboard mode switch persists this setting in the database.
TRADING_MODE=live
TEST_MODE_NOTIONAL_MULTIPLIER=0.1

# Use three different long random values in deployment.
TRADING_CONTROL_TOKEN=
MANUAL_SCAN_TOKEN=
ADMIN_BEARER_TOKEN=
DISCORD_WEBHOOK_URL=
SCAN_DISCORD_WEBHOOK_URL=
ORDER_DISCORD_WEBHOOK_URL=
DISCORD_COOLDOWN_SECONDS=900
DISCORD_MAX_RETRIES=4
DISCORD_MAX_TIMEPOINTS=50
PUBLIC_BASE_URL=http://localhost:8080
REPLAY_MAX_HOURS=168
REPLAY_MAX_CONCURRENT_JOBS=1
REPLAY_REQUIRE_HISTORICAL_SPREAD=true
REPLAY_REQUIRE_HISTORICAL_ACTIVE_FLOW=false
REPLAY_CACHE_TTL_SECONDS=3600
BACKTEST_DEFAULT_FEE_PCT=0.05
BACKTEST_DEFAULT_SLIPPAGE_PCT=0.02
